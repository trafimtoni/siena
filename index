                    <div class="flex-1 min-w-0">
                        <div class="text-sm font-bold t-main truncate">${escapeHtml(x.name)}</div>
                        <div class="text-[11px] t-sub">${x.id === u.id ? 'Текущий пользователь' : 'Задач: ' + x.tasks.length}</div>
                    </div>
                    ${x.id === u.id ? '' : `<button class="px-3 py-1.5 rounded-lg accent-bg text-white text-[11px] font-semibold hover:opacity-90" onclick="switchUser('${x.id}')">Выбрать</button>`}
                    <button class="w-8 h-8 rounded-lg text-rose-500 hover:bg-rose-500/15 text-xs transition-colors ${state.users.length < 2 ? 'opacity-30 cursor-not-allowed' : ''}" ${state.users.length < 2 ? 'disabled' : ''} onclick="deleteUser('${x.id}')" aria-label="Удалить пользователя ${escapeHtml(x.name)}" title="Удалить">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </div>
            `).join('');
        }

        function toggleUserMenu(e) {
            if (e) e.stopPropagation();
            const menu = document.getElementById('userMenu');
            menu.classList.toggle('hidden');
            document.getElementById('userBtn').setAttribute('aria-expanded', String(!menu.classList.contains('hidden')));
        }
        function closeUserMenu() {
            document.getElementById('userMenu').classList.add('hidden');
            document.getElementById('userBtn').setAttribute('aria-expanded', 'false');
        }

        function switchUser(id) {
            closeUserMenu();
            if (id === state.currentUserId) return;
            if (!state.users.some(u => u.id === id)) return;
            state.currentUserId = id;
            saveState();
            applySettings();
            renderUserUI();
            renderTasks();
            renderCalendar();
            renderDevices();
            renderRooms();
            notify('Пользователь', 'Вы вошли как ' + currentUser().name);
        }

        let newUserAccent = PALETTE[1];
        function renderSwatches() {
            document.getElementById('newUserSwatches').innerHTML = PALETTE.map(c => `
                <button type="button" class="swatch ${c === newUserAccent ? 'selected' : ''}" style="background:${c}" onclick="pickSwatch('${c}')" aria-label="Цвет ${c}"></button>
            `).join('');
        }
        function pickSwatch(c) { newUserAccent = c; renderSwatches(); }

        function openAddUserModal() {
            closeUserMenu();
            // Предлагаем цвет, которого ещё нет у других пользователей
            newUserAccent = PALETTE.find(c => !state.users.some(u => u.accent.toLowerCase() === c)) || PALETTE[0];
            renderSwatches();
            openModal('addUserModal', 'userModalBox', 'newUserName');
        }
        function closeAddUserModal() { closeModal('addUserModal', 'userModalBox'); }

        function addNewUser() {
            const input = document.getElementById('newUserName');
            const name = input.value.trim();
            if (!name) { notify('Ошибка', 'Введите имя пользователя'); return; }
            if (state.users.some(u => u.name.toLowerCase() === name.toLowerCase())) {
                notify('Ошибка', 'Пользователь с таким именем уже есть');
                return;
            }
            const u = makeUser(name, newUserAccent, currentUser().theme, []);
            state.users.push(u);
            state.currentUserId = u.id;
            saveState();
            input.value = '';
            closeAddUserModal();
            applySettings();
            renderUserUI();
            renderTasks();
            renderDevices();
            renderRooms();
            renderCalendar();
            notify('Пользователь', 'Добавлен: ' + name);
        }

        function deleteUser(id) {
            if (state.users.length < 2) return;
            const u = state.users.find(x => x.id === id);
            if (!u) return;
            if (!confirm(`Удалить пользователя «${u.name}» вместе с его задачами?`)) return;
            state.users = state.users.filter(x => x.id !== id);
            if (state.currentUserId === id) state.currentUserId = state.users[0].id;
            saveState();
            applySettings();
            renderUserUI();
            renderTasks();
            renderDevices();
            renderRooms();
            renderCalendar();
            notify('Пользователь', 'Удалён: ' + u.name);
        }

        /* =====================================================
           Устройства и комнаты
