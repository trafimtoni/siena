                <div class="flex items-center justify-between gap-2 p-2 rounded-xl hover:bg-[var(--surface-2)] transition-colors">
                    <label class="flex items-center gap-3 cursor-pointer text-xs font-medium min-w-0 ${t.done ? 'line-through t-mute' : 't-main'}">
                        <input type="checkbox" ${t.done ? 'checked' : ''} onchange="toggleTask(${t.id})" class="rounded w-4 h-4 shrink-0" style="accent-color: var(--accent);">
                        <span class="break-words min-w-0">${escapeHtml(t.text)}</span>
                    </label>
                    <button onclick="deleteTask(${t.id})" class="t-mute hover:text-rose-500 text-xs px-1 transition-colors" aria-label="Удалить задачу">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </div>
            `).join('');
        }
        function toggleTask(id) {
            const t = currentUser().tasks.find(x => x.id === id);
            if (t) { t.done = !t.done; saveState(); renderTasks(); }
        }
        function deleteTask(id) {
            const u = currentUser();
            u.tasks = u.tasks.filter(t => t.id !== id);
            saveState(); renderTasks(); renderUserUI();
            notify('Задача', 'Задача удалена');
        }
        function handleTaskEnter(e) { if (e.key === 'Enter') addNewTask(); }
        function addNewTask() {
            const input = document.getElementById('newTaskInput');
            const text = input.value.trim();
            if (!text) return;
            currentUser().tasks.push({ id: Date.now(), text: text, done: false });
            input.value = '';
            saveState(); renderTasks(); renderUserUI();
            notify('Задачи', 'Добавлена новая задача');
        }

        /* =====================================================
           Календарь и события
           ===================================================== */
        function dateKey(y, m, d) {
            return y + '-' + String(m + 1).padStart(2, '0') + '-' + String(d).padStart(2, '0');
        }
        function eventsOn(key) { return state.events.filter(e => e.date === key); }
        function formatEventDate(key) {
            const [y, m, d] = key.split('-').map(Number);
            return d + ' ' + ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'][m - 1] + ' ' + y;
        }

        function renderCalendar() {
            const monthNames = ['Январь', 'Февраль', 'Март', 'Апрель', 'Май', 'Июнь', 'Июль', 'Август', 'Сентябрь', 'Октябрь', 'Ноябрь', 'Декабрь'];
            document.getElementById('calendarMonth').innerText = monthNames[view.month] + ' ' + view.year;
            const grid = document.getElementById('calendarGrid');
            if (!grid) return;

            let html = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'].map(d => `<div class="text-[10px] font-bold t-mute py-1">${d}</div>`).join('');
            const firstDay = new Date(view.year, view.month, 1).getDay();
            const daysInMonth = new Date(view.year, view.month + 1, 0).getDate();
            const startDay = firstDay === 0 ? 6 : firstDay - 1;
            for (let i = 0; i < startDay; i++) html += '<div></div>';

            const today = new Date();
            for (let d = 1; d <= daysInMonth; d++) {
                const isToday = d === today.getDate() && view.month === today.getMonth() && view.year === today.getFullYear();
                const key = dateKey(view.year, view.month, d);
                const hasEvents = eventsOn(key).length > 0;
                html += `
                    <button class="relative h-7 w-7 mx-auto flex items-center justify-center text-xs font-semibold rounded-full cursor-pointer transition-all ${isToday ? 'accent-bg text-white shadow-sm accent-glow' : 't-main hover:bg-[var(--surface-3)]'}" onclick="openEventModal('${key}')" aria-label="${d}, ${eventsOn(key).length} событий">
                        ${d}
                        ${hasEvents ? `<span class="absolute -top-0.5 -right-0.5 w-1.5 h-1.5 rounded-full ${isToday ? 'bg-white' : ''}" style="background: ${isToday ? '#fff' : 'var(--accent)'};"></span>` : ''}
                    </button>`;
            }
            grid.innerHTML = html;
        }
        function changeMonth(dir) {
            view.month += dir;
            if (view.month > 11) { view.month = 0; view.year++; }
            if (view.month < 0) { view.month = 11; view.year--; }
            renderCalendar();
        }

        function openEventModal(key) {
            currentEventDate = key;
            document.getElementById('eventModalDate').innerText = formatEventDate(key);
            renderEventModalList();
            const input = document.getElementById('newEventInput');
            input.value = '';
            openModal('eventModal', 'eventModalBox', 'newEventInput');
        }
        function closeEventModal() { closeModal('eventModal', 'eventModalBox'); }

        function renderEventModalList() {
            const box = document.getElementById('eventModalList');
            const list = eventsOn(currentEventDate);
            box.innerHTML = list.length
                ? list.map(e => `
                    <div class="flex items-center justify-between gap-2 p-2.5 rounded-xl surface-2">
                        <span class="text-xs font-medium t-main min-w-0 flex-1 break-words">${escapeHtml(e.title)}</span>
                        <button onclick="deleteEvent(${e.id})" class="t-mute hover:text-rose-500 text-xs px-1 transition-colors" aria-label="Удалить событие"><i class="fa-solid fa-trash"></i></button>
                    </div>`).join('')
                : '<div class="text-xs t-mute text-center py-2">Событий на этот день нет</div>';
        }

        function addEventFromModal() {
            const input = document.getElementById('newEventInput');
            const title = input.value.trim();
            if (!title) { notify('Ошибка', 'Введите название события'); return; }
            state.events.push({ id: Date.now(), date: currentEventDate, title: title });
            addLog(`Событие «${title}» · ${formatEventDate(currentEventDate)}`);
            saveState();
            input.value = '';
            renderEventModalList();
            renderCalendar();
            renderUpcomingEvents();
            renderLog();
            notify('Календарь', 'Событие добавлено');
        }

        function deleteEvent(id) {
            const e = state.events.find(x => x.id === id);
            if (!e) return;
            state.events = state.events.filter(x => x.id !== id);
            saveState();
            renderEventModalList();
            renderCalendar();
            renderUpcomingEvents();
            notify('Календарь', 'Событие удалено');
        }

        function renderUpcomingEvents() {
            const box = document.getElementById('upcomingEvents');
            const count = document.getElementById('eventCount');
            if (!box) return;
            const todayStr = dateKey(new Date().getFullYear(), new Date().getMonth(), new Date().getDate());
            const upcoming = state.events
                .filter(e => e.date >= todayStr)
                .sort((a, b) => a.date.localeCompare(b.date))
                .slice(0, 5);
            count.innerText = state.events.length;
            if (!upcoming.length) {
                box.innerHTML = '<div class="text-xs t-mute text-center py-2">Событий нет</div>';
                return;
            }
            box.innerHTML = upcoming.map(e => `
                <div class="flex items-center justify-between gap-2 py-2 border-b hairline last:border-0">
                    <span class="text-xs t-main min-w-0 truncate">${escapeHtml(e.title)}</span>
                    <span class="text-[10px] t-mute whitespace-nowrap">${escapeHtml(formatEventDate(e.date))}</span>
                </div>`).join('');
        }

        /* =====================================================
           Крупные часы
           ===================================================== */
        function renderClock() {
            const now = new Date();
            const hh = String(now.getHours()).padStart(2, '0');
            const mm = String(now.getMinutes()).padStart(2, '0');
            const ss = String(now.getSeconds()).padStart(2, '0');
            document.getElementById('bigClock').innerText = hh + ':' + mm;
            document.getElementById('clockSeconds').innerText = ss;
            const weekdays = ['воскресенье', 'понедельник', 'вторник', 'среда', 'четверг', 'пятница', 'суббота'];
            const months = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'];
            const wd = weekdays[now.getDay()];
            const dateStr = wd.charAt(0).toUpperCase() + wd.slice(1) + ', ' + now.getDate() + ' ' + months[now.getMonth()] + ' ' + now.getFullYear();
            document.getElementById('bigClockDate').innerText = dateStr;
            document.getElementById('bigClockDate').classList.remove('capitalize');
        }

        /* =====================================================
           Сиена: умный помощник
           ===================================================== */
        let siennaGreeted = false;
        function toggleAssistant() {
            const panel = document.getElementById('siennaPanel');
            const opening = panel.classList.contains('hidden');
            panel.classList.toggle('hidden');
            if (opening) {
                if (!siennaGreeted) {
                    siennaGreeted = true;
                    addMsg('bot', 'Привет! Я Сиена, помощник вашего дома. Скажите или напишите команду -- например «включи люстру», «сценарий ночь», «громкость 40». Голосом я активируюсь по слову «Сиена».');
                }
                setTimeout(() => document.getElementById('siennaInput').focus(), 50);
            } else {
                stopMic();
            }
        }
        function closeSienna() {
            document.getElementById('siennaPanel').classList.add('hidden');
            stopMic();
        }

        function addMsg(who, text) {
            const box = document.getElementById('siennaMessages');
            const div = document.createElement('div');
            div.className = 'sienna-msg ' + (who === 'user'
                ? 'ml-auto max-w-[85%] px-3.5 py-2 rounded-2xl rounded-br-md text-xs leading-relaxed accent-bg text-white'
                : 'mr-auto max-w-[90%] px-3.5 py-2 rounded-2xl rounded-bl-md text-xs leading-relaxed surface-2 t-main');
            div.innerText = text;
            box.appendChild(div);
            // держим максимум 30 сообщений
            while (box.children.length > 30) box.removeChild(box.firstChild);
            box.scrollTop = box.scrollHeight;
        }

        function siennaReply(text) {
            addMsg('bot', text);
            speak(text);
        }

        function speak(text) {
            if (!('speechSynthesis' in window)) return;   // без озвучки, если не поддерживается
            try {
                window.speechSynthesis.cancel();
                const u = new SpeechSynthesisUtterance(text);
                u.lang = 'ru-RU';
                u.rate = 1.05;
                window.speechSynthesis.speak(u);
            } catch (e) { /* озвучка не критична */ }
        }

        function sendSiennaText() {
            const input = document.getElementById('siennaInput');
            const t = input.value.trim();
            if (!t) return;
            input.value = '';
            addMsg('user', t);
            setTimeout(() => processCommand(t, false), 250);
        }

        /* ---------- Голосовая активация ---------- */
        let recognition = null;
        let micActive = false;

        function updateMicUI() {
            const btn = document.getElementById('siennaMicBtn');
            btn.classList.toggle('bg-rose-500', micActive);
            btn.innerHTML = micActive
                ? '<i class="fa-solid fa-microphone-slash"></i>'
                : '<i class="fa-solid fa-microphone"></i>';
            btn.setAttribute('aria-label', micActive ? 'Остановить прослушивание' : 'Голосовая активация');
            const st = document.getElementById('siennaStatus');
            st.innerHTML = micActive
                ? 'Слушаю: скажите «Сиена, …»<span class="wave ml-1"></span><span class="wave"></span><span class="wave"></span>'
                : 'Умный помощник';
        }

        function stopMic() {
            micActive = false;
            if (recognition) {
                try { recognition.onend = null; recognition.abort(); } catch (e) {}
                recognition = null;
            }
            updateMicUI();
        }

        function toggleMic() {
            const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SR) {
                siennaReply('Голосовой ввод не поддерживается этим браузером. Введите команду текстом -- я всё равно помогу.');
                return;
            }
            if (micActive) { stopMic(); return; }
            recognition = new SR();
            recognition.lang = 'ru-RU';
            recognition.continuous = true;
            recognition.interimResults = false;
            recognition.onresult = e => {
                for (let i = e.resultIndex; i < e.results.length; i++) {
                    if (e.results[i].isFinal) {
                        const t = e.results[i][0].transcript.trim();
                        if (t) {
                            addMsg('user', t);
                            processCommand(t, true);
                        }
                    }
                }
            };
            recognition.onerror = e => {
                if (e.error === 'not-allowed' || e.error === 'service-not-allowed') {
                    siennaReply('Нет доступа к микрофону. Разрешите его в браузере или введите команду текстом.');
                    stopMic();
                }
            };
            recognition.onend = () => { if (micActive) { try { recognition.start(); } catch (e) {} } };
            try {
                recognition.start();
                micActive = true;
                updateMicUI();
                addMsg('bot', 'Слушаю. Активируюсь по слову «Сиена» -- например: «Сиена, включи музыку».');
            } catch (e) {
                stopMic();
            }
        }

        /* ---------- Разбор команд ---------- */
        function processCommand(raw, fromVoice) {
            let text = String(raw || '').replace(/\s+/g, ' ').trim();
            const low = text.toLowerCase();

            // голосом ассистент активируется по слову «Сиена»
            if (fromVoice) {
                const idx = low.indexOf('сиена');
                if (idx < 0) return;                                  // слово-активатор не произнесено
                text = text.slice(idx + 5);
            } else if (low.startsWith('сиена')) {
                text = text.slice(5);
            }
            text = text.replace(/^[\s,.;:---]+/, '').trim();
            if (!text) {
                siennaReply('Слушаю! Например: «включи люстру», «сценарий вечер», «громкость 30», «тёмная тема».');
                return;
            }
            const c = text.toLowerCase();

            /* --- время --- */
            if (/который час|сколько времени/.test(c)) {
                const now = new Date();
                siennaReply('Сейчас ' + now.getHours() + ' ' + plural(now.getHours(), 'час', 'часа', 'часов') + ' ' + now.getMinutes() + ' ' + plural(now.getMinutes(), 'минута', 'минуты', 'минут') + '.');
                return;
            }

            /* --- приветствие --- */
            if (/^(привет|здравствуй|добрый|салют|хай)/.test(c)) {
                siennaReply('Привет, ' + currentUser().name + '! Чем помочь? Могу включить приборы, сменить станцию, тему или добавить задачу.');
                return;
            }

            /* --- темы --- */
            if (/тёмн|темн|ночн/.test(c) && /тем/.test(c)) {
                setTheme('dark');
                siennaReply('Включаю тёмную тему.');
                return;
            }
            if (/светл/.test(c) && /тем/.test(c)) {
                setTheme('light');
                siennaReply('Включаю светлую тему.');
                return;
            }

            /* --- громкость --- */
            const volMatch = c.match(/громк[^0-9]*(\d{1,3})/);
            if (/громк/.test(c)) {
                if (volMatch) {
                    setVolume(Math.min(100, Number(volMatch[1])));
                    saveState();
                    siennaReply('Громкость ' + Math.round(currentUser().volume) + ' процентов.');
                } else if (/тише/.test(c)) {
                    changeVolume(-15); saveState();
                    siennaReply('Делаю тише: ' + Math.round(currentUser().volume) + ' процентов.');
                } else if (/громче/.test(c)) {
                    changeVolume(15); saveState();
                    siennaReply('Делаю громче: ' + Math.round(currentUser().volume) + ' процентов.');
                } else {
                    siennaReply('Скажите, например: «громкость 40».');
                }
                return;
            }

            /* --- музыка --- */
            if (/музык|радио|песн|трек|станци/.test(c)) {
                if (/выключ|стоп|пауз|прекрат/.test(c)) {
                    if (isPlaying) { togglePlay(); siennaReply('Останавливаю музыку.'); }
                    else siennaReply('Музыка уже не играет.');
                } else if (/следующ|вперёд/.test(c)) {
                    selectStation(state.radioStation + 1);
                    siennaReply('Включаю станцию «' + RADIO_STATIONS[state.radioStation].name + '».');
                } else if (/предыдущ|назад/.test(c)) {
                    selectStation(state.radioStation - 1);
                    siennaReply('Включаю станцию «' + RADIO_STATIONS[state.radioStation].name + '».');
                } else {
                    if (!isPlaying) togglePlay();
                    siennaReply('Включаю радио: «' + RADIO_STATIONS[state.radioStation].name + '».');
                }
                return;
            }

            /* --- сценарии --- */
            if (/сценари|вечер|ночь|спать|уш(ё|е)л|уход|дом/.test(c)) {
                let scene = null;
                if (/вечер/.test(c)) scene = 'evening';
                else if (/ночь|спать/.test(c)) scene = 'night';
                else if (/уш(ё|е)л|уход|из дома/.test(c)) scene = 'away';
                if (scene) {
                    runScene(scene);
                    siennaReply('Выполняю сценарий. Приборы переключены в демо-панели.');
                } else {
                    siennaReply('Какой сценарий? «Вечер», «Ночь» или «Ушёл из дома».');
                }
                return;
            }

            /* --- задачи --- */
            const taskMatch = text.match(/добав(?:ь|ить)\s+задач[уи]?\s+(.+)/i);
            if (taskMatch) {
                const taskText = taskMatch[1].trim();
                currentUser().tasks.push({ id: Date.now(), text: taskText, done: false });
                saveState(); renderTasks(); renderUserUI();
                siennaReply('Добавила задачу: «' + taskText + '».');
                return;
            }
            if (/задач/.test(c) && /покажи|список|что нужно/.test(c)) {
                const t = currentUser().tasks;
                siennaReply(t.length
                    ? 'Ваши задачи: ' + t.map(x => (x.done ? 'выполнено -- ' : '') + '«' + x.text + '»').join('; ') + '.'
                    : 'Задач пока нет. Скажите: «добавь задачу …».');
                return;
            }

            /* --- события --- */
            const evMatch = text.match(/добав(?:ь|ить)\s+событи[ея]\s+(.+)/i);
            if (evMatch) {
                const title = evMatch[1].trim();
                const now = new Date();
                state.events.push({ id: Date.now(), date: dateKey(now.getFullYear(), now.getMonth(), now.getDate()), title: title });
                saveState(); renderCalendar(); renderUpcomingEvents();
                siennaReply('Добавила событие на сегодня: «' + title + '». Если нужна другая дата -- нажмите на неё в календаре.');
                return;
            }

            /* --- разделы --- */
            if (/новост/.test(c)) { switchView('overview'); siennaReply('Открываю обзор с новостями.'); return; }
            if (/комнат/.test(c) && /открой|покажи/.test(c)) { switchView('rooms'); siennaReply('Открываю комнаты.'); return; }
            if (/настройк/.test(c) && /открой|покажи/.test(c)) { switchView('settings'); siennaReply('Открываю настройки.'); return; }

            /* --- приборы --- */
            if (/включ|выключ|зажги|потуши|запусти|остан/.test(c)) {
                const wantOn = /включ|зажги|запусти/.test(c);
                // ищем прибор по названию и по русским словам-синонимам типа
                const DEVICE_KEYWORDS = {
                    light: ['свет', 'ламп', 'люстр', 'торшер', 'ночник', 'гирлянд'],
                    tv: ['телевизор', 'тв', 'телик', 'экран'],
                    ac: ['кондиционер', 'сплит', 'климат'],
                    plug: ['розетк', 'удлинител', 'блок питани']
                };
                const words = c.replace(/[^а-яё0-9 ]/gi, ' ').split(/\s+/).filter(w => w.length > 3);
                const dev = state.devices.find(d => {
                    const nm = d.name.toLowerCase();
                    if (words.some(w => nm.includes(w) || nm.includes(w.slice(0, Math.max(4, w.length - 2))))) return true;
                    const kws = DEVICE_KEYWORDS[d.type] || [];
                    return kws.some(k => c.includes(k));
                });
                if (dev) {
                    setDeviceState(dev, wantOn);
                    siennaReply((wantOn ? 'Включаю прибор: «' : 'Выключаю прибор: «') + dev.name + '». Готово.');
                } else {
                    siennaReply('Не нашла такой прибор. Есть: ' + state.devices.map(d => d.name).join(', ') + '.');
                }
                return;
            }

            siennaReply('Не поняла команду. Попробуйте: «включи люстру», «громкость 40», «сценарий ночь», «тёмная тема», «добавь задачу …».');
        }

        function plural(n, one, few, many) {
            const m10 = n % 10, m100 = n % 100;
            if (m10 === 1 && m100 !== 11) return one;
            if (m10 >= 2 && m10 <= 4 && (m100 < 10 || m100 >= 20)) return few;
            return many;
        }

        function setTheme(theme) {
            const u = currentUser();
            if (u.theme !== theme) { u.theme = theme; saveState(); applySettings(); }
        }

        function setDeviceState(dev, on) {
            if (dev.state !== on) {
                dev.state = on;
                addLog(`${dev.name}: ${on ? 'включено' : 'выключено'} (Сиена)`);
                saveState();
                renderDevices();
                renderRooms();
                renderLog();
            }
        }

        /* =====================================================
           Погода
           ===================================================== */
        function fetchWeather() {
            const temp = document.getElementById('weatherTemp');
            const desc = document.getElementById('weatherDesc');
            fetch('https://api.open-meteo.com/v1/forecast?latitude=55.75&longitude=37.61&current=temperature_2m,weather_code&timezone=auto')
                .then(res => { if (!res.ok) throw new Error(res.status); return res.json(); })
                .then(data => {
                    if (!data || !data.current) throw new Error('no data');
                    temp.innerText = Math.round(data.current.temperature_2m) + '°C';
                    const codes = {
                        0: 'Ясно', 1: 'Малооблачно', 2: 'Переменная облачность', 3: 'Пасмурно',
                        45: 'Туман', 48: 'Изморозь', 51: 'Лёгкая морось', 53: 'Морось', 55: 'Сильная морось',
                        61: 'Лёгкий дождь', 63: 'Дождь', 65: 'Сильный дождь', 71: 'Лёгкий снег', 73: 'Снег', 75: 'Сильный снег',
                        80: 'Ливень', 81: 'Сильный ливень', 82: 'Очень сильный ливень', 95: 'Гроза'
                    };
                    desc.innerHTML = `<i class="fa-solid fa-location-dot accent-color"></i> Москва · ${codes[data.current.weather_code] || 'Нет описания'}`;
                })
                .catch(() => {
                    temp.innerText = '--°C';
                    desc.innerHTML = '<i class="fa-solid fa-triangle-exclamation text-amber-500"></i> Нет данных о погоде';
                });
        }

        /* =====================================================
           Радио: станции по свайпу, круглый регулятор громкости
           ===================================================== */
        let isPlaying = false;

        function renderPlayer() {
            const st = RADIO_STATIONS[state.radioStation];
            document.getElementById('trackTitle').innerText = st.name;
            document.getElementById('trackDesc').innerText = st.desc;
            const img = document.getElementById('coverImg');
            img.style.display = '';
            img.src = st.cover;
            document.getElementById('stationDots').innerHTML = RADIO_STATIONS.map((s, i) =>
                `<span class="w-1.5 h-1.5 rounded-full" style="background:${i === state.radioStation ? 'var(--accent)' : 'var(--surface-3)'};"></span>`
            ).join('');
            updateVolumeUI();
        }

        function selectStation(i) {
            if (i < 0) i = RADIO_STATIONS.length - 1;
            if (i >= RADIO_STATIONS.length) i = 0;
            if (i === state.radioStation) return;
            state.radioStation = i;
            saveState();
            renderPlayer();
            const audio = document.getElementById('radioPlayer');
            if (isPlaying) {
                // Играла другая станция -- переключаем поток на лету
                audio.src = RADIO_STATIONS[i].url;
                audio.play().catch(() => {
                    setPlayingUI(false);
                    notify('Аудио', 'Не удалось запустить поток');
                });
            }
            notify('Радио', 'Станция: ' + RADIO_STATIONS[i].name);
        }

        function setPlayingUI(on) {
            isPlaying = on;
            const btn = document.getElementById('playBtn');
            btn.innerHTML = on ? '<i class="fa-solid fa-pause"></i>' : '<i class="fa-solid fa-play ml-0.5"></i>';
            btn.setAttribute('aria-label', on ? 'Пауза' : 'Воспроизвести');
            document.getElementById('liveBadge').classList.toggle('hidden', !on);
        }
        function togglePlay() {
            const audio = document.getElementById('radioPlayer');
            if (isPlaying) {
                audio.pause();
                audio.removeAttribute('src');      // отсоединяемся от потока
                setPlayingUI(false);
                notify('Музыка', 'Воспроизведение остановлено');
                return;
            }
            audio.src = RADIO_STATIONS[state.radioStation].url;
            audio.play().then(() => {
                setPlayingUI(true);
                notify('Музыка', 'Воспроизведение: ' + RADIO_STATIONS[state.radioStation].name);
            }).catch(() => {
                setPlayingUI(false);
                notify('Аудио', 'Не удалось запустить поток');
            });
        }

        /* ---------- Громкость: круглый регулятор ---------- */
        function updateVolumeUI() {
            const v = Math.round(currentUser().volume);
            document.getElementById('volLabel').innerText = v + '%';
            const knob = document.getElementById('volKnob');
            knob.setAttribute('aria-valuenow', String(v));
            // поворот указателя: -135° (0%) … +135° (100%)
            const angle = -135 + (v / 100) * 270;
            document.getElementById('volPointer').style.transform = `translate(-50%, -100%) rotate(${angle}deg)`;
        }
        function applyVolume() {
            document.getElementById('radioPlayer').volume = currentUser().volume / 100;
            updateVolumeUI();
        }
        function setVolume(v) {
            const u = currentUser();
            u.volume = Math.max(0, Math.min(100, Math.round(Number(v) || 0)));
            applyVolume();
        }
        function changeVolume(delta) {
            const u = currentUser();
            setVolume(u.volume + delta);
            notify('Громкость', Math.round(u.volume) + '%');
        }

        function initVolumeKnob() {
            const knob = document.getElementById('volKnob');
            let dragging = false;

            function angleToVolume(e) {
                const rect = knob.getBoundingClientRect();
                const cx = rect.left + rect.width / 2, cy = rect.top + rect.height / 2;
                const a = Math.atan2(e.clientY - cy, e.clientX - cx) * 180 / Math.PI + 90; // 0° -- вверх
                return Math.max(0, Math.min(100, Math.round(((a + 135) / 270) * 100)));
            }
            knob.addEventListener('pointerdown', e => {
                dragging = true;
                knob.setPointerCapture(e.pointerId);
                setVolume(angleToVolume(e));
            });
            knob.addEventListener('pointermove', e => { if (dragging) setVolume(angleToVolume(e)); });
            knob.addEventListener('pointerup',   () => { dragging = false; saveState(); });
            knob.addEventListener('pointercancel', () => { dragging = false; });
            knob.addEventListener('wheel', e => {
                e.preventDefault();
                changeVolume(e.deltaY < 0 ? 5 : -5);
            }, { passive: false });
            knob.addEventListener('keydown', e => {
                if (e.key === 'ArrowUp' || e.key === 'ArrowRight') { e.preventDefault(); changeVolume(5); saveState(); }
                if (e.key === 'ArrowDown' || e.key === 'ArrowLeft') { e.preventDefault(); changeVolume(-5); saveState(); }
            });
        }

        /* ---------- Свайпы (мышь и касания) ---------- */
        function attachSwipe(el, onLeft, onRight) {
            if (!el) return;
            let sx = 0, sy = 0, active = false;
            el.addEventListener('pointerdown', e => {
                // свайп не должен срабатывать на кнопках и регуляторе громкости
                if (e.target.closest('button, input, a, #volKnob')) { active = false; return; }
                sx = e.clientX; sy = e.clientY; active = true;
            });
            el.addEventListener('pointerup', e => {
                if (!active) return;
                active = false;
                const dx = e.clientX - sx, dy = e.clientY - sy;
                if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) {
                    if (dx < 0) onLeft(); else onRight();
                }
            });
            el.addEventListener('pointercancel', () => { active = false; });
        }

        function initSwipes() {
            // Свайп по всему радио-виджету -- смена радиостанции
            attachSwipe(
                document.getElementById('radioCard'),
                () => selectStation(state.radioStation + 1),
                () => selectStation(state.radioStation - 1)
            );
            // Свайп по аватару -- смена аватара
            attachSwipe(
                document.getElementById('greetingAvatar'),
                () => cycleAvatar(1),
                () => cycleAvatar(-1)
            );
        }

        function cycleAvatar(dir) {
            const u = currentUser();
            let idx = AVATARS.indexOf(u.avatar);
            if (idx < 0) idx = 0;
            idx = (idx + dir + AVATARS.length) % AVATARS.length;
            u.avatar = AVATARS[idx];
            saveState();
            renderUserUI();
            notify('Аватар', 'Выбран новый аватар');
        }

        document.addEventListener('DOMContentLoaded', () => {
            const audio = document.getElementById('radioPlayer');
            initVolumeKnob();
            initSwipes();
            audio.addEventListener('error', () => {
                if (audio.getAttribute('src')) { setPlayingUI(false); notify('Аудио', 'Поток недоступен'); }
            });
            // Пользователи ещё не загружены -- громкость применится после загрузки состояния
            if (state.users.length) applyVolume();
        });

        /* =====================================================
           Новости (RSS через rss2json)
           ===================================================== */
        const newsCache = {};          // sourceId -> { t, items }
        const NEWS_TTL = 5 * 60 * 1000;
        let newsReq = 0;

        function renderNewsSources() {
            document.getElementById('newsSources').innerHTML = Object.keys(NEWS_SOURCES).map(id => `
                <button class="src-pill px-3 py-1.5 rounded-full text-[11px] font-semibold surface-2 t-sub ${id === state.newsSource ? 'active' : ''}" onclick="setNewsSource('${id}')">${escapeHtml(NEWS_SOURCES[id].name)}</button>
            `).join('');
        }
        function setNewsSource(id) {
            if (!NEWS_SOURCES[id]) return;
            state.newsSource = id;
            saveState();
            renderNewsSources();
            loadNews(false);
        }

        function timeAgo(s) {
            if (!s) return '';
            const d = new Date(String(s).replace(' ', 'T') + (/[zZ]|[+-]\d\d:?\d\d$/.test(s) ? '' : 'Z'));
            if (isNaN(d)) return '';
            const min = Math.round((Date.now() - d.getTime()) / 60000);
            if (min < 1) return 'только что';
            if (min < 60) return min + ' мин назад';
            const h = Math.round(min / 60);
            if (h < 24) return h + ' ч назад';
            return d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'short' });
        }

        function renderNewsItems(items, srcId) {
            const list = document.getElementById('newsList');
            if (!items.length) {
                list.innerHTML = '<div class="text-xs t-mute text-center py-6">Новостей нет</div>';
                return;
            }
            list.innerHTML = items.slice(0, 6).map(n => {
                const link = safeUrl(n.link);
                const thumb = safeUrl(n.thumbnail || (n.enclosure && n.enclosure.link));
                const tag = link ? 'a' : 'div';
                const attrs = link ? `href="${escapeHtml(link)}" target="_blank" rel="noopener noreferrer"` : '';
                return `
                    <${tag} ${attrs} class="news-item flex items-center gap-3.5 p-2.5 rounded-xl">
                        ${thumb ? `<img src="${escapeHtml(thumb)}" alt="" loading="lazy" referrerpolicy="no-referrer" class="w-16 h-16 rounded-xl object-cover shrink-0 surface-2" onerror="this.style.display='none'">` : `<div class="w-16 h-16 rounded-xl surface-2 t-mute flex items-center justify-center shrink-0"><i class="fa-regular fa-newspaper"></i></div>`}
                        <div class="min-w-0">
                            <div class="text-xs font-bold t-main clamp-2 leading-snug">${escapeHtml(n.title || '')}</div>
                            <div class="text-[10px] t-mute mt-1">${escapeHtml(NEWS_SOURCES[srcId].name)}${n.pubDate ? ' · ' + escapeHtml(timeAgo(n.pubDate)) : ''}</div>
                        </div>
                    </${tag}>`;
            }).join('');
        }

        function loadNews(force) {
            const srcId = state.newsSource;
            const src = NEWS_SOURCES[srcId];
            const list = document.getElementById('newsList');
            const meta = document.getElementById('newsMeta');
            const icon = document.getElementById('newsRefreshIcon');
            const cached = newsCache[srcId];

            if (!force && cached && Date.now() - cached.t < NEWS_TTL) {
                renderNewsItems(cached.items, srcId);
                meta.innerText = src.name + ' · обновлено ' + new Date(cached.t).toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
                return;
            }

            const req = ++newsReq;
            meta.innerText = src.name + ' · загрузка...';
            icon.classList.add('animate-spin');
            list.innerHTML = Array.from({ length: 4 }).map(() => '<div class="flex gap-3.5 p-2.5"><div class="skeleton w-16 h-16 shrink-0"></div><div class="flex-1 space-y-2 pt-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-2/3"></div></div></div>').join('');

            const ctrl = new AbortController();
            const timer = setTimeout(() => ctrl.abort(), 12000);
            fetch('https://api.rss2json.com/v1/api.json?rss_url=' + encodeURIComponent(src.rss), { signal: ctrl.signal })
                .then(r => { if (!r.ok) throw new Error(r.status); return r.json(); })
                .then(data => {
                    if (!data || data.status !== 'ok' || !Array.isArray(data.items)) throw new Error('bad feed');
                    newsCache[srcId] = { t: Date.now(), items: data.items };
                    if (req !== newsReq) return;                  // пришёл устаревший ответ
                    renderNewsItems(data.items, srcId);
                    meta.innerText = src.name + ' · обновлено ' + new Date().toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
                })
                .catch(() => {
                    if (req !== newsReq) return;
                    meta.innerText = src.name + ' · не удалось загрузить';
                    list.innerHTML = `
                        <div class="text-center py-6">
                            <div class="text-xs t-sub mb-3"><i class="fa-solid fa-triangle-exclamation text-amber-500 mr-1"></i> Не удалось загрузить новости. Проверьте подключение к интернету.</div>
                            <button class="px-4 py-2 rounded-xl accent-bg text-white text-xs font-semibold" onclick="loadNews(true)">Повторить</button>
                        </div>`;
                })
                .finally(() => { clearTimeout(timer); if (req === newsReq) icon.classList.remove('animate-spin'); });
        }

        /* =====================================================
           Запуск
           ===================================================== */
        window.addEventListener('load', function () {
            loadState();
            applyVolume();          // применяем сохранённую громкость после загрузки пользователей
            renderClock();
            setInterval(renderClock, 1000);
            fetchWeather();
            loadNews(false);
            setInterval(() => loadNews(false), 10 * 60 * 1000);
        });
    </script>
</body>
</html>
