        /* ---------- Сценарии ---------- */
        function runScene(name) {
            const scenes = {
                evening: { title: 'Вечер', apply: d => { if (d.type === 'light') d.state = (d.room === 'living'); } },
                night:   { title: 'Ночь',  apply: d => { if (d.type === 'light' || d.type === 'tv') d.state = false; } },
                away:    { title: 'Ушёл из дома', apply: d => { d.state = false; } }
            };
            const s = scenes[name];
            if (!s) return;
            state.devices.forEach(s.apply);
            addLog(`Сценарий «${s.title}» (демо)`);
            saveState();
            renderDevices();
            renderRooms();
            renderLog();
            notify('Сценарий', `«${s.title}» выполнен в демо-панели`);
        }

        /* ---------- Журнал ---------- */
        function addLog(text) {
            state.log.unshift({ t: Date.now(), who: currentUser().name, text: text });
            if (state.log.length > 50) state.log.length = 50;
        }
        function renderLog() {
            const box = document.getElementById('eventLog');
