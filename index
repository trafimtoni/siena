        function getRoomIcon(key) {
            return { living: 'fa-couch', bedroom: 'fa-bed', kitchen: 'fa-utensils', bath: 'fa-bath' }[key] || 'fa-door-closed';
        }

        function renderRooms() {
            const plan = document.getElementById('floorPlan');
