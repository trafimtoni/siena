        let currentEventDate = null;   // дата, открытая в окне события

        function currentUser() {
            return state.users.find(u => u.id === state.currentUserId) || state.users[0];
        }

        /* =====================================================
           Хранилище
           ===================================================== */
        function loadState() {
            let loaded = false;
            try {
                const saved = localStorage.getItem(STORAGE_KEY);
                if (saved) {
                    const p = JSON.parse(saved);
                    if (p && Array.isArray(p.users) && p.users.length) {
                        state = Object.assign(state, p);
                        loaded = true;
                    }
                }
            } catch (e) { console.error(e); }

            // Перенос данных из старой версии (один пользователь)
            if (!loaded) {
                try {
                    const legacy = JSON.parse(localStorage.getItem(LEGACY_KEY) || 'null');
                    if (legacy) {
                        const u = makeUser(legacy.user || 'Антон', legacy.accent || DEFAULT_ACCENT, 'light', Array.isArray(legacy.tasks) ? legacy.tasks : []);
                        state.users = [u];
                        state.currentUserId = u.id;
                        if (Array.isArray(legacy.devices)) state.devices = legacy.devices;
                        state.bg = legacy.bg || '';
                        loaded = true;
                    }
                } catch (e) { console.error(e); }
            }

            if (!loaded) {
                const u = makeUser('Антон', DEFAULT_ACCENT, null, [
                    { id: 1, text: 'Проверить фильтры очистителя', done: false },
                    { id: 2, text: 'Настроить вечернее освещение', done: true }
                ]);
                state.users = [u];
                state.currentUserId = u.id;
            }
            if (!state.users.some(u => u.id === state.currentUserId)) state.currentUserId = state.users[0].id;
            // Дозаполняем поля, которых могло не быть в старых версиях
            state.users.forEach(u => {
                if (!u.avatar) u.avatar = 'fa-user-gear';
                if (typeof u.volume !== 'number' || isNaN(u.volume)) u.volume = 70;
                if (!Array.isArray(u.tasks)) u.tasks = [];
            });
            if (!NEWS_SOURCES[state.newsSource]) state.newsSource = 'lenta';
            if (!Array.isArray(state.log)) state.log = [];
            if (!Array.isArray(state.events)) state.events = [];
            if (!Number.isInteger(state.radioStation) || state.radioStation < 0 || state.radioStation >= RADIO_STATIONS.length) state.radioStation = 0;

            renderAll();
        }

        function saveState() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
                return true;
            } catch (e) {
                console.error(e);
                notify('Ошибка', 'Не удалось сохранить изменения в браузере');
                return false;
            }
        }

        function renderAll() {
            applySettings();
            renderUserUI();
            renderDevices();
            renderRooms();
            renderCalendar();
            renderTasks();
            renderLog();
            renderNewsSources();
            renderPlayer();
            renderUpcomingEvents();
            renderClock();
        }

        /* =====================================================
           Утилиты
           ===================================================== */
        function escapeHtml(str) {
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }
        function safeUrl(u) {
            try {
                const x = new URL(u);
                return (x.protocol === 'https:' || x.protocol === 'http:') ? x.href : '';
            } catch (e) { return ''; }
        }
        function initial(name) { return (name || '?').trim().charAt(0).toUpperCase() || '?'; }

        /* ---------- Аватар: иконка или своё фото ---------- */
        function avatarHTML(u) {
            if (u.avatarPhoto) return `<img src="${u.avatarPhoto}" alt="Аватар" class="w-full h-full object-cover">`;
            return `<i class="fa-solid ${escapeHtml(u.avatar || AVATARS[0])}"></i>`;
        }

        function handleAvatarUpload(e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function (evt) {
                const img = new Image();
                img.onload = function () {
                    // Квадратный кроп 192×192 по центру
                    const SIZE = 192;
                    const canvas = document.createElement('canvas');
                    canvas.width = SIZE; canvas.height = SIZE;
                    const ctx = canvas.getContext('2d');
                    const side = Math.min(img.width, img.height);
                    ctx.drawImage(img, (img.width - side) / 2, (img.height - side) / 2, side, side, 0, 0, SIZE, SIZE);
                    currentUser().avatarPhoto = canvas.toDataURL('image/jpeg', 0.75);
                    if (saveState()) {
                        renderUserUI();
                        notify('Аватар', 'Фото установлено');
                    }
                };
                img.onerror = () => notify('Ошибка', 'Не удалось прочитать изображение');
                img.src = evt.target.result;
            };
            reader.readAsDataURL(file);
            e.target.value = '';
        }

        function clearAvatarPhoto(e) {
            if (e) e.stopPropagation();
            const u = currentUser();
            if (u.avatarPhoto) {
                delete u.avatarPhoto;
                saveState();
                renderUserUI();
                notify('Аватар', 'Фото убрано');
            }
        }

        let toastTimer = null;
        function notify(title, msg) {
            const toast = document.getElementById('customToast');
            document.getElementById('toastTitle').innerText = title;
            document.getElementById('toastMsg').innerText = msg;
            toast.classList.remove('opacity-0', 'translate-y-10', 'pointer-events-none');
            toast.classList.add('opacity-100', 'translate-y-0');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                toast.classList.remove('opacity-100', 'translate-y-0');
                toast.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
            }, 2500);
        }

        function switchView(viewId) {
            document.querySelectorAll('.view-tab').forEach(v => v.classList.remove('active'));
            const target = document.getElementById('view-' + viewId);
            if (target) target.classList.add('active');
            document.querySelectorAll('.nav-link').forEach(l => l.classList.toggle('active', l.dataset.view === viewId));
        }

        /* =====================================================
           Тема, цвет, обои
           ===================================================== */
        function hexToRgb(hex) {
            const h = (hex || DEFAULT_ACCENT).replace('#', '');
            return [parseInt(h.substring(0, 2), 16) || 0, parseInt(h.substring(2, 4), 16) || 0, parseInt(h.substring(4, 6), 16) || 0];
        }

        function applySettings() {
            const u = currentUser();
            const root = document.documentElement;
            const [r, g, b] = hexToRgb(u.accent);
            root.style.setProperty('--accent', u.accent);
            root.style.setProperty('--accent-glow', `rgba(${r}, ${g}, ${b}, 0.25)`);
            root.style.setProperty('--accent-soft', `rgba(${r}, ${g}, ${b}, 0.15)`);

            const dark = u.theme === 'dark';
            root.classList.toggle('dark', dark);
            document.getElementById('themeIcon').className = 'fa-solid ' + (dark ? 'fa-sun' : 'fa-moon');
            document.getElementById('themeSwitch').checked = dark;

            document.body.style.backgroundImage = state.bg ? `url(${state.bg})` : '';

            document.getElementById('settingName').value = u.name;
            document.getElementById('settingColor').value = u.accent;
        }

        function toggleTheme() {
            const u = currentUser();
            u.theme = u.theme === 'dark' ? 'light' : 'dark';
            saveState();
            applySettings();
            notify('Тема', u.theme === 'dark' ? 'Тёмная тема включена' : 'Светлая тема включена');
        }

        function handleBgUpload(e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function (evt) {
                const img = new Image();
                img.onload = function () {
                    const canvas = document.createElement('canvas');
                    const ctx = canvas.getContext('2d');
                    const MAX_WIDTH = 1200;
                    let width = img.width, height = img.height;
                    if (width > MAX_WIDTH) { height *= MAX_WIDTH / width; width = MAX_WIDTH; }
                    canvas.width = width; canvas.height = height;
                    ctx.drawImage(img, 0, 0, width, height);
                    const prev = state.bg;
                    state.bg = canvas.toDataURL('image/jpeg', 0.7);
                    if (saveState()) {
                        applySettings();
                        notify('Фон', 'Новые обои установлены');
                    } else {
                        state.bg = prev;
                    }
                };
                img.onerror = () => notify('Ошибка', 'Не удалось прочитать изображение');
                img.src = evt.target.result;
            };
            reader.readAsDataURL(file);
            e.target.value = '';
        }

        function clearBg() {
            state.bg = '';
            saveState();
            applySettings();
            notify('Фон', 'Обои убраны');
        }

        function saveSettings() {
            const u = currentUser();
            u.name = document.getElementById('settingName').value.trim() || 'Пользователь';
            u.accent = document.getElementById('settingColor').value;
            saveState();
            applySettings();
            renderUserUI();
            renderDevices();
            renderRooms();
            renderCalendar();
            renderTasks();
            notify('Настройки', 'Все изменения сохранены');
        }

