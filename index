                    <div class="flex items-center gap-3.5 min-w-0">
                        <div class="w-10 h-10 rounded-xl ${d.state ? 'accent-bg text-white shadow-md accent-glow' : 'surface-2 t-mute'} flex items-center justify-center text-sm transition-all shrink-0">
                            <i class="fa-solid ${deviceIcon(d.type)}"></i>
